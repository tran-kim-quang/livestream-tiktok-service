# ── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_USERNAME=
TIKTOK_LIVE_RETRY_SEC=30
# Euler Stream sign key (https://www.eulerstream.com) — nên đặt để kết nối TikTok ổn định.
EULER=

# ── Chọn lọc comment ──────────────────────────────────────────────────────────
COMMENT_MIN_CHARS=2
COMMENT_MAX_CHARS=300
COMMENT_DEDUP_WINDOW_SEC=60
COMMENT_USER_COOLDOWN_SEC=10
COMMENT_BLOCKLIST=
COMMENT_PRIORITY_KEYWORDS=
COMMENT_BUFFER_SIZE=50
COMMENT_MAX_AGE_SEC=30
COMMENT_FRESH_WINDOW_SEC=10
# 0 = không giới hạn tốc độ phục vụ.
COMMENT_MAX_SERVE_PER_SEC=0

# GPU / TTS
# local = GPU trên máy chạy service (Docker dùng host.docker.internal)
GPU_HOST=100.98.141.59
# GPU_HOST=100.98.141.59
GPU_NAME=
# Máy remote: đặt user để bật SSH tunnel tới VoiceStudio loopback.
GPU_SSH_USER=meconlonton
GPU_SSH_PORT=22
# Trong Docker dùng /run/secrets/gpu_ssh_key (mount cấu hình ở docker-compose.yml).
GPU_SSH_KEY=
GPU_SSH_PASSWORD=
# Nên trỏ tới file known_hosts; để trống sẽ bỏ kiểm tra host key và có warning.
GPU_SSH_KNOWN_HOSTS=
TTS_ENGINE=voicestudio
VOICESTUDIO_API_PORT=3900
# Chỉ dùng khi gọi API remote trực tiếp, không qua SSH.
VOICESTUDIO_API_KEY=
# Port Pyramid Video Web, chỉ dùng khi TTS_ENGINE=pyramid.
VOICESTUDIO_PORT=8080
TTS_ENABLED=1
TTS_VOICE_ID=
# Chunk đầu ngắn để giảm thời gian nghe thấy âm thanh đầu tiên.
TTS_FIRST_CHUNK_MAX_WORDS=6
# Để trống hoặc 0 để dùng mặc định của engine.
TTS_FIRST_CHUNK_NUM_STEP=8
# Các chunk sau; để trống để dùng mặc định của engine.
TTS_NUM_STEP=16
TTS_MAX_CONCURRENCY=1
TTS_TIMEOUT_SEC=120

# ── Service port ──────────────────────────────────────────────────────────────
LIVESTREAM_SERVICE_PORT=8002
