# ── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_USERNAME=
TIKTOK_LIVE_RETRY_SEC=30
# Euler Stream sign key (https://www.eulerstream.com) — nên đặt để kết nối TikTok ổn định.
EULER=

# ── Chọn lọc comment ──────────────────────────────────────────────────────────
COMMENT_MIN_CHARS=2
COMMENT_MAX_CHARS=300
COMMENT_DEDUP_WINDOW_SEC=60
# Thời gian ghi nhớ ID message TikTok để loại backlog phát lại.
COMMENT_SKIP_BACKLOG=1
COMMENT_BACKLOG_SLACK_SEC=2
COMMENT_MSG_ID_TTL_SEC=600
# Cooldown tính từ lúc comment của user được lấy để trả lời, không phải lúc nhận.
COMMENT_USER_COOLDOWN_SEC=8
# Gộp tối đa 3 comment liên tiếp chưa được phục vụ của cùng user trong 10 giây.
COMMENT_MERGE_WINDOW_SEC=10
COMMENT_MERGE_MAX_PARTS=3
# Để trống: không chặn lời thô tục; chỉ thêm từ/cụm từ thật sự muốn loại bỏ.
COMMENT_BLOCKLIST=
COMMENT_PRIORITY_KEYWORDS=
COMMENT_BUFFER_SIZE=50
COMMENT_MAX_AGE_SEC=30
COMMENT_FRESH_WINDOW_SEC=15
# 0 = không giới hạn tốc độ phục vụ.
COMMENT_MAX_SERVE_PER_SEC=0

# GPU / TTS
# local = GPU trên máy chạy service (Docker dùng host.docker.internal)
GPU_HOST=100.98.141.59
# GPU_HOST=100.98.141.59
GPU_NAME=
# Máy remote: đặt user để bật SSH tunnel tới VoiceStudio loopback.
GPU_SSH_USER=meconlonton
GPU_SSH_PORT=22
# Trong Docker dùng /run/secrets/gpu_ssh_key (mount cấu hình ở docker-compose.yml).
GPU_SSH_KEY=
GPU_SSH_PASSWORD=
# Nên trỏ tới file known_hosts; để trống sẽ bỏ kiểm tra host key và có warning.
GPU_SSH_KNOWN_HOSTS=
TTS_ENGINE=voicestudio
VOICESTUDIO_API_PORT=3900
# Chỉ dùng khi gọi API remote trực tiếp, không qua SSH.
VOICESTUDIO_API_KEY=
# Port Pyramid Video Web, chỉ dùng khi TTS_ENGINE=pyramid.
VOICESTUDIO_PORT=8080
TTS_ENABLED=1
TTS_VOICE_ID=
# Chunk đầu ngắn để giảm thời gian nghe thấy âm thanh đầu tiên.
TTS_FIRST_CHUNK_MAX_WORDS=6
# Để trống hoặc 0 để dùng mặc định của engine.
TTS_FIRST_CHUNK_NUM_STEP=8
# Các chunk sau; để trống để dùng mặc định của engine.
TTS_NUM_STEP=16
TTS_MAX_CONCURRENCY=1
TTS_TIMEOUT_SEC=120

# ── Phát audio trên máy chạy service ─────────────────────────────────────────
# auto = ưu tiên sounddevice, fallback ffplay; sounddevice | ffplay | none.
AUDIO_PLAYER=auto
# Index hoặc một phần tên thiết bị (không phân biệt hoa thường); rỗng = default.
AUDIO_OUTPUT_DEVICE=
# URL WebSocket cho audio bridge chạy native trên Windows.
BRIDGE_WS_URL=ws://127.0.0.1:8002/api/agent/ws
# Auto-speak vừa broadcast WebSocket vừa phát trên loa/headset local.
AGENT_LOCAL_PLAYBACK=1

# ── Agent / LLM (OpenAI-compatible API) ───────────────────────────────────────────
# Base URL kiểu OpenAI, ví dụ https://api.openai.com/v1 hoặc https://ollama.com/v1
# (…/api/chat của Ollama được tự đổi sang …/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SEC=30
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.7
LLM_MAX_RPS=60
LLM_MAX_CONCURRENCY=2
# Agent chỉ bật khi có LLM_API_KEY; đặt 0 để buộc tắt.
AGENT_ENABLED=1
# Khi bật, service là consumer duy nhất của comment queue.
AGENT_AUTO=0
# Auto mode phát PCM qua /api/agent/ws; chỉ có hiệu lực khi TTS_ENABLED=1.
AGENT_AUTO_SPEAK=1
# Tạo lời chào ngắn bằng service để TTS chạy ngay, không chờ token LLM đầu tiên.
AGENT_GREETING=1
# Các mẫu phân cách bằng |; {name} là display name đã làm sạch cho TTS.
AGENT_GREETING_TEMPLATES={name} ơi,|Chào {name},|À {name},
# Không có listener thì giữ comment trong buffer để comment tự hết hạn.
AGENT_SKIP_WHEN_NO_LISTENER=1
# Khoảng nghỉ sau khi client phát xong một reply.
AGENT_REPLY_GAP_SEC=0.6
# Thời gian chờ thêm ngoài độ dài audio khi bridge chưa gửi ACK played.
AGENT_PLAYED_ACK_GRACE_SEC=3
AGENT_SYSTEM_PROMPT=
AGENT_PROMPT_FILE=
AGENT_HISTORY_TURNS=6
AGENT_REPLY_BUFFER=50

# ── Service port ──────────────────────────────────────────────────────────────
LIVESTREAM_SERVICE_PORT=8002
